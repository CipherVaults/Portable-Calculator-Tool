{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portable Calculator Tool",
  "version": "0.1.0",
  "identifier": "com.portablecalculator.tool",
  "build": {
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Portable Calculator Tool",
        "width": 1120,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0E0F12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
